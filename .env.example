# --- Database (Neon) ---
# Neon serverless Postgres connection string (pooled). Get this from the Neon dashboard.
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Admin auth (internal pipeline UI) ---
# Comma-separated list of allowed admin logins as email:password pairs.
# Example: ADMIN_USERS="aashir@systems10.com:changeme,closer@systems10.com:secret2"
ADMIN_USERS="admin@systems10.com:changeme"

# Secret used to sign admin session cookies (any long random string).
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- Machine API auth (Make.com / Clay / Instantly webhooks) ---
# Shared secret sent by orchestration tools in the `X-API-Key` header.
# Generate one with: openssl rand -hex 32
API_KEY="replace-with-a-long-random-api-key"
